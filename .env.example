# Project Caesar - Environment Variables Configuration
# Copy this file to .env and fill in your actual values.
# These variables are automatically loaded by the Python orchestrator and services.

# ==========================================
# Agentic Alerter (Twilio Integration)
# ==========================================
# Required for autonomous threat escalation phone calls.
# If these are left blank, the orchestrator will still run but will fall back to stdout/log alerts.
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_FROM=+1234567890
AUTHORITIES_PHONE=+0987654321

# ==========================================
# Network Ports (Optional Overrides)
# ==========================================
# ZMQ_PUB_PORT=5555
# ZMQ_SUB_PORT=5556
# DASHBOARD_PORT=8090

# ==========================================
# AI Inference & Vision
# ==========================================
# OLLAMA_ENDPOINT=http://localhost:11434
# OLLAMA_MODEL=llava
